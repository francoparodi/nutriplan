# =============================================================================
# Nutriplan - environment file (the ONLY example file)
#
#   Development:  cp .env.example .env     then   docker compose up -d --build
#   Production:   install.sh creates .env from this file and fills in the
#                 PRODUCTION values for you (see README, section "Production").
#
# Every variable is marked:
#   [COMMON]  used by both the development and the production stack
#   [DEV]     used only by docker-compose.yml          (ignored in production)
#   [PROD]    used only by docker-compose-prod.yml     (ignored in development)
# Lines starting with "#" are comments; keep the KEY=value lines without spaces.
# =============================================================================


# ----------------------------------------------------------------- [COMMON] ---

# [COMMON] Password of the PostgreSQL user "nutriplan".
#   DEV : any value, the default is fine.
#   PROD: REQUIRED, use a long random value (install.sh generates one for you).
#         It is stored in the database on the first start: do not change it
#         afterwards without also changing it inside PostgreSQL.
POSTGRES_PASSWORD=nutriplan

# [COMMON] Password of the technical "admin" user, created ONLY the first time,
# on an empty database. Change it from the application afterwards.
#   DEV : the default is fine.
#   PROD: REQUIRED, install.sh generates a random one and prints it once.
ADMIN_PASSWORD=admin123

# [COMMON] Time zone used to decide what "today" is in the patients' diaries.
APP_TZ=Europe/Rome

# [COMMON] Login lifetime in days (sliding: renewed each time the user is active).
SESSION_DAYS=180

# [COMMON] Upload limits in MB: documents/photos, and backup archives.
MAX_UPLOAD_MB=15
MAX_BACKUP_MB=500


# -------------------------------------------------------------------- [DEV] ---

# [DEV] Host folder holding the PostgreSQL data files of the development stack.
# Data survives "docker compose down -v"; delete the folder to start from scratch.
DATA_DIR=./data

# [DEV] Host port where PostgreSQL is published (bound to localhost only).
DB_PORT=55432

# [DEV] Create demo data on an empty database: users admin / medico / franco /
# giorgia (passwords equal to the user names) and two sample meal plans.
SEED_DEMO=true

# [DEV] Session cookie "Secure" flag. Keep false for plain http://localhost or
# http://<lan-ip>:8000. (In production it is always true: the site is HTTPS.)
COOKIE_SECURE=false


# ------------------------------------------------------------------- [PROD] ---

# [PROD] Public host name of the application. Its DNS record must point to the
# server, and ports 80 and 443 must be reachable from the internet.
DOMAIN=nutriplan.example.com

# [PROD] E-mail registered with Let's Encrypt (certificate expiry notices).
ACME_EMAIL=admin@example.com

# [PROD] Docker image of the backend (contains the built web interface).
# install.zip sets this for you; for a manual run use e.g. myuser/nutriplan-backend:1.0.0
NUTRIPLAN_IMAGE=nutriplan-backend:local

# [PROD] Host folder with ALL persistent production data: PostgreSQL files and
# TLS certificates. Relative paths are relative to the install folder. Put it on
# a disk that you back up.
PROD_DATA_DIR=./data

# [PROD] Demo data in production. Keep false: demo users have trivial passwords.
PROD_SEED_DEMO=false
